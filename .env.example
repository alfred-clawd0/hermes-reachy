# hermes-reachy configuration — copy to your Hermes .env (or export in the gateway env).
# No hosts, ports, or robot ids are baked into the code; set them here.

# Required: the WebSocket port the robot's voice app connects to.
REACHY_WS_PORT=8770

# Required: the shared secret the voice app sends as "api_key" in its first "hello" frame.
# The platform refuses to start without one. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
REACHY_WS_API_KEY=

# Alternative to REACHY_WS_API_KEY: read the secret from a file (surrounding whitespace is
# stripped; keep it chmod 600). REACHY_WS_API_KEY wins when both are set.
# REACHY_WS_API_KEY_FILE=~/.hermes/reachy_ws_api_key

# Optional: bind address for the WebSocket server (default 127.0.0.1 — loopback, for a voice
# app running on this machine). Use 0.0.0.0 only if the voice app runs on ANOTHER machine:
# ws:// sends the API key and all text in plaintext, so prefer an SSH tunnel or a TLS proxy.
# REACHY_WS_HOST=127.0.0.1

# Optional: comma-separated allowlist of robot ids permitted to connect.
# Unset or empty means the default robot id "reachy".
# REACHY_ALLOWED_ROBOTS=reachy

# Optional (dev only): accept ANY robot id — the API key is still required.
# REACHY_ALLOW_ALL_ROBOTS=false

# Optional: default robot id for proactive / cron delivery and the body tool.
# REACHY_HOME_CHANNEL=reachy
