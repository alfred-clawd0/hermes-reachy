# hermes-reachy configuration — copy to your Hermes .env (or export in the gateway env).
# No hosts, ports, or robot ids are baked into the code; set them here.

# Required: the WebSocket port the robot's voice app connects to.
REACHY_WS_PORT=8770

# Optional: bind address for the WebSocket server (default 0.0.0.0).
# REACHY_WS_HOST=0.0.0.0

# Optional: comma-separated allowlist of robot ids permitted to connect.
# REACHY_ALLOWED_ROBOTS=reachy

# Optional (dev only): accept ANY robot id — disables the allowlist.
# REACHY_ALLOW_ALL_ROBOTS=false

# Optional: default robot id for proactive / cron delivery and the body tool.
# REACHY_HOME_CHANNEL=reachy
